@prefix : <https://example.org/empkg/tutorial#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://example.org/empkg/tutorial#> .

<https://example.org/empkg/tutorial> rdf:type owl:Ontology ;
                                      rdfs:label "EMPKG-lite Tutorial" .

#################################################################
#    Object Properties
#################################################################

###  https://example.org/empkg/tutorial#belongsToStudy
:belongsToStudy rdf:type owl:ObjectProperty ;
                rdfs:domain :Sample ;
                rdfs:range :Study .


###  https://example.org/empkg/tutorial#hasObservedASV
:hasObservedASV rdf:type owl:ObjectProperty ;
                rdfs:domain :Sample ;
                rdfs:range :ASV .


#################################################################
#    Data properties
#################################################################

###  https://example.org/empkg/tutorial#hasPH
:hasPH rdf:type owl:DatatypeProperty ;
       rdfs:domain :Sample ;
       rdfs:range xsd:decimal .


###  https://example.org/empkg/tutorial#hasSampleID
:hasSampleID rdf:type owl:DatatypeProperty ;
             rdfs:domain :Sample ;
             rdfs:range xsd:string .


###  https://example.org/empkg/tutorial#hasSequence
:hasSequence rdf:type owl:DatatypeProperty ;
             rdfs:domain :ASV ;
             rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  https://example.org/empkg/tutorial#ASV
:ASV rdf:type owl:Class ;
     owl:disjointWith :Sample ;
     rdfs:comment "Variante de secuencia inferida a partir de las lecturas después de controlar errores"@es ;
     rdfs:label "Amplicon Sequence Variant"@en .


###  https://example.org/empkg/tutorial#Sample
:Sample rdf:type owl:Class ;
        rdfs:comment "Trozo de material recolectado para análisis."@es ;
        rdfs:label "Muestra"@es .


###  https://example.org/empkg/tutorial#SoilSample
:SoilSample rdf:type owl:Class ;
            rdfs:subClassOf :Sample ;
            owl:disjointWith :WaterSample .


###  https://example.org/empkg/tutorial#Study
:Study rdf:type owl:Class ;
       rdfs:comment "Estudio que ha recolectado y analizado muestras."@es ;
       rdfs:label "Estudio"@es .


###  https://example.org/empkg/tutorial#WaterSample
:WaterSample rdf:type owl:Class ;
             rdfs:subClassOf :Sample .


#################################################################
#    Individuals
#################################################################

###  https://example.org/empkg/tutorial#asv_01
:asv_01 rdf:type owl:NamedIndividual ,
                 :ASV ;
        :hasSequence "ACGTACGT" .


###  https://example.org/empkg/tutorial#sample_01
:sample_01 rdf:type owl:NamedIndividual ,
                    :SoilSample ;
           owl:sameAs :sample_04 ;
           :belongsToStudy :study_01 ;
           :hasObservedASV :asv_01 ;
           :hasPH 6.4 ;
           :hasSampleID "S1" .


###  https://example.org/empkg/tutorial#sample_04

###  https://example.org/empkg/tutorial#sample_02
:sample_02 rdf:type owl:NamedIndividual ,
                    :WaterSample ;
           :belongsToStudy :study_01 ;
           :hasObservedASV :asv_01 ;
           :hasSampleID "S2" .


###  https://example.org/empkg/tutorial#sample_03
:sample_03 rdf:type owl:NamedIndividual ;
           :belongsToStudy :study_01 .


###  https://example.org/empkg/tutorial#sample_04
:sample_04 rdf:type owl:NamedIndividual ,
                    :Sample ;
           :belongsToStudy :study_01 ;
           :hasSampleID "S1" .


###  https://example.org/empkg/tutorial#study_01
:study_01 rdf:type owl:NamedIndividual ,
                   :Study .


